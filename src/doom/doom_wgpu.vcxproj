  <ItemGroup>
    <ClInclude Include="..\common\gpu.h" />
    <ClInclude Include="..\common\platform_win32.h" />
    <ClInclude Include="..\common\shader.h" />
    <!-- Dawn headers as items: 10x's parser indexes project files, not include dirs or props items. -->
    <ClInclude Include="..\..\third_party\dawn\include\webgpu\webgpu.h" />
    <ClInclude Include="..\..\third_party\dawn\include\dawn\webgpu.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\shaders\**\*.wgsl" />
  </ItemGroup>

